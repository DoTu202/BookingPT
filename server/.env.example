# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Full MongoDB connection string (Atlas or local).
MONGODB_URI=mongodb://localhost:27017/bookingpt
# Long random secret for signing JWTs (>= 32 chars in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Optional ---------------------------------------------------------------
PORT=3001
NODE_ENV=development
JWT_EXPIRES_IN=1d
# pino log level: fatal | error | warn | info | debug (silent in tests).
# "info" logs startup + failed requests (4xx/5xx); "debug" also logs every successful request.
LOG_LEVEL=info

# SMTP (Gmail App Password). If unset, emails are logged instead of sent.
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="BookingPT <no-reply@example.com>"

# Public base URL used for uploaded image links, e.g. https://api.example.com
# Leave empty in development to derive it from the request host.
PUBLIC_URL=
# Comma-separated browser origins allowed by CORS (native apps don't need this).
CORS_ORIGINS=
# Number of reverse proxies in front of the API (e.g. 1 behind Nginx/Render).
TRUST_PROXY=0

# Push notifications (FCM). Firebase console > Project settings > Service accounts >
# Generate new private key. Either the path to that JSON file or its content on one line.
# Leave empty to disable push. Never commit the file.
FIREBASE_SERVICE_ACCOUNT=

# Accounts created by `npm run test-accounts` (non-destructive, dev only).
TEST_CLIENT_EMAIL=test.client@bookingpt.dev
TEST_CLIENT_PASSWORD=
TEST_PT_EMAIL=test.pt@bookingpt.dev
TEST_PT_PASSWORD=
